# Roblox build artifacts and local place files
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Wally
Packages/
ServerPackages/
DevPackages/
wally.lock

# Toolchain
sourcemap.json
roblox.yml

# Obsidian per-device state (shared settings in vault/.obsidian are committed)
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache
vault/.trash/

# LihFolk notes: a local copy of the plugin's vault, 53 MB (see vault/04 Tech/LihFolk.md)
vault/LihFolk/

# Other games' screenshots used as references: local only (the repo is public),
# the notes link their sources. Put them in any folder named third-party/.
**/third-party/
vault/02 Art/References/ui/
vault/02 Art/References/lobby/professional-*/
vault/01 Design/ValorantUIExamples/
vault/01 Design/RivalsMapConcepts/

# Blender backups
*.blend1
*.blend2

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary copy of tools/studio/rojo synced into Studio while guns are (re)built
src/server/WeaponBuild/
# Same for tools/studio/abilities while Mod props are (re)built
src/server/AbilityBuild/

# Downloaded sound libraries (large; only the picked/converted clips are kept)
art-source/audio/_download/
art-source/audio/library/
# CC0 recordings fetched by tools/audio/fetch_audio.py (one folder each; ledger in the vault)
art-source/audio/downloads/
# Audition reels (tools/audio/build_sound_atlas.py --preview and the like)
art-source/audio/*Preview.wav
# Mod sound auditions rendered by tools/audio/mod_sfx.py
art-source/audio/ModSfx/

# Viewmodel hand-clipping samples (tools/studio/SampleHands.luau), regenerated on demand
art-source/viewmodel/checks/

# Intermediates the texture scripts write next to their outputs (tools/vfx/*)
art-source/vfx/**/_*.png
# Preview renders of map props
art-source/maps/**/*_preview.png

# Python bytecode
__pycache__/

# Claude Code: per-session worktrees and the Studio lane locks
.claude/worktrees/
.claude/settings.local.json
.claude-locks/

# Single renders behind the weapon model sheets (the sheets themselves are kept)
art-source/weapons/ModelSheets/panels/
