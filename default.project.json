{
  "name": "GlitchedGauntletGame",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$path": "assets"
      },
      "Lobby": {
        "$path": "src/lobby/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "LobbyServer": {
        "$path": "src/lobby/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "LobbyClient": {
          "$path": "src/lobby/client",
          "SharedUi": {
            "$path": "src/client/Util/Ui.luau"
          }
        }
      }
    },
    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/first"
      }
    }
  }
}
