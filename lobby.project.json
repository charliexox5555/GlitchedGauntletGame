{
  "name": "GlitchedGauntletLobby",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$path": "assets"
      },
      "Lobby": {
        "$path": "src/lobby/shared"
      }
    },
    "ServerScriptService": {
