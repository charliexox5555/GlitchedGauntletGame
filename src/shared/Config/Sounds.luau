--!strict
-- Shared (non-gun) sounds: hit feedback, damage taken, the low-ammo tick, and
-- the id of the sound atlas. EVERY GUN SOUND (shots, reloads, draw, inspect)
-- lives in Config/GunSounds, one entry per gun.
--
-- Gunshots and the UI sounds live in one "atlas" audio asset
-- (one upload instead of ~80; Open Cloud only allows 10 audio uploads a
-- month without ID verification). "atlas:<Name>" means a slice of it;
-- Config/SoundAtlas has the time ranges and variants (generated by
-- tools/audio/build_sound_atlas.py, which explains how each sound is made).
-- "<Name>_Far" slices are what other players hear; AudioController picks
-- them automatically.
--
-- Gunshots: CC0 recordings of real firearms ("The Free Firearm Sound
-- Library", Ben Jaszczak et al.), lightly polished. Handling foley:
-- Audioscape library. Melee: ProSoundEffects library (both Roblox-licensed
-- for use in experiences).
--
-- To go back to the first atlas (raw recordings, 2026-10-25), set ATLAS to
-- 95621839199583 and restore this file and Config/SoundAtlas.luau from git
-- (commit 7f485d4). Rejected layered/synth test: 88658182501404.

local function id(n: number): string
	return "rbxassetid://" .. tostring(n)
end

return table.freeze({
	-- v3 (2026-11-05, lane F): the v2 gun atlas unchanged plus the knife and
	-- sound-pass slices appended (tools/audio/build_sfx.py -> GameAtlas.flac).
	-- v2 (guns only) was 105241531021545, v1 95621839199583.
	ATLAS = id(133446200676645),

	LowAmmo = "atlas:LowAmmo", -- synthesized tick on each shot from a near-empty mag

	-- Feedback (2026-11-05: real CC0 recordings; the synthesized v2 ones are
	-- still in the atlas: HitTick, HeadDing, Kill, KillHead, to go back).
	HitBody = "atlas:HitConfirm", -- a glass clink
	HitHead = "atlas:HeadConfirm", -- a fork / spoon tapped on glass
	Kill = "atlas:KillConfirm", -- a metal service bell
	KillHead = "atlas:KillConfirm",
	Damage = "atlas:Damage",

	-- Footsteps by surface (Controllers/FootstepController), the slide's
	-- skid, and the in-match UI click.
	STEPS = table.freeze({
		Concrete = "atlas:StepConcrete",
		Metal = "atlas:StepMetal",
		Wood = "atlas:StepWood",
		Grass = "atlas:StepGrass",
		Snow = "atlas:StepSnow",
	} :: { [string]: string }),
	SlideStart = "atlas:SlideStart",
	UiClick = "atlas:UiClick",
})
