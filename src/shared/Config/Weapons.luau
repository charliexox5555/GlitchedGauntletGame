local Weapons = {}

Weapons.list = table.freeze(weapons)

-- Wave 1 starting loadout (Gunplay build order: Byte first, Bitrate second).
Weapons.DEFAULT_LOADOUT = table.freeze({
	Primary = "Bitrate",
	Secondary = "Byte",
	Melee = "Cutter",
})

