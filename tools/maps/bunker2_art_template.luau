--!strict
-- Bunker2 art pass (vault/01 Design/Maps/Bunker2.md): GENERATED by tools/maps/bunker2_art.py (run
-- `python tools/maps/bunker2_layout.py --luau`). Edit the placement rules there: the same data drives the dressed
-- coplanar (z-fighting) check. Edit colours in tools/maps/bunker2_style.py (the STYLE block).
-- Dresses the greybox with the kit group "Kit" (tools/blender/build_map_kit_bunker2.py; asset in
-- art-source/maps/Bunker2/Exports/assets.json). Run after the greybox and after installing the kit:
--   python tools/studio/maps/kit_bundle.py Bunker2 Kit -o bunker2_kit.luau          (run it first)
--   python tools/studio/maps/bundle.py Bunker2 Greybox Art Lighting -o bunker2.luau  (then this)
-- Re-runnable: it rebuilds Bunker2.Art.<Section>. The greybox stays the collision: parts the kit replaces are hidden
-- (they keep CanCollide/CanQuery), the rest get their role's finish. Pieces with a stretch other than 1 are scaled
-- along their local Z; parts with the role Band take the end tone (B cobalt, A amber, the shared middle warm grey);
-- sign plates carry rendered-font decals (no part-built text).

type RoleLook = { color: string, material: string, variant: string }

-- BEGIN STYLE (generated by tools/maps/bunker2_style.py --luau; edit the values there)
--@STYLE@
-- END STYLE

-- Sign art: rendered-font decals (tools/maps/bunker2_signs.py), image ids.
local SIGN: { [string]: string } = {
--@SIGNS@
}

newMap("Bunker2", CFrame.new(-3000, 200, 1500))
local MaterialService = game:GetService("MaterialService")

for name, v in VARIANTS do
	if v[3] == "" then
		continue
	end
	local found = MaterialService:FindFirstChild(name)
	local mv: MaterialVariant
	if found and found:IsA("MaterialVariant") then
		mv = found
	else
		mv = Instance.new("MaterialVariant")
		mv.Name = name
		mv.Parent = MaterialService
	end
	mv.BaseMaterial = (Enum.Material :: any)[v[1]]
	mv.StudsPerTile = v[2]
	mv.ColorMap = "rbxassetid://" .. v[3]
	mv.NormalMap = "rbxassetid://" .. v[4]
	mv.RoughnessMap = if v[5] ~= "" then "rbxassetid://" .. v[5] else ""
	mv.MaterialPattern = Enum.MaterialPattern.Regular
end

local function apply(part: BasePart, role: string, color: Color3?)
	local look = ROLE[role]
	if not look then
		return
	end
	part.Color = color or Color3.fromHex(look.color)
	if look.material == "Neon" then
		part.Material = Enum.Material.Neon
		part.MaterialVariant = ""
		part.CastShadow = false
		return
	end
	part.Material = (Enum.Material :: any)[look.material]
	local v = VARIANTS[look.variant]
	part.MaterialVariant = if v and v[3] ~= "" then look.variant else ""
	if look.material == "Glass" then
		part.Transparency = 0.55
		part.CastShadow = false
	end
end

local SECTIONS: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = SECTIONS[name]
	if not f then
		f = section("Art", name)
		SECTIONS[name] = f
	end
	return f :: Folder
end

-- { section, piece, x, y, z, yaw, stretch along local Z, tint ("B" / "A" / "N" / "" = by position), text }
local PLACES: { { any } } = {
--@PLACEMENTS@
}

local function bandKey(key: string, z: number): string
	if key == "B" or key == "A" or key == "N" then
		return key
	end
	if math.abs(z) < 22 then
		return "N" -- the sunwell and the pump rooms belong to nobody
	end
	return if z > 0 then "B" else "A"
end

-- Scales a placed piece along its own Z (its length): sizes along that axis and offsets from the pivot.
local function stretch(m: Model, s: number)
	if math.abs(s - 1) < 1e-4 then
		return
	end
	local pivot = m:GetPivot()
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(d.CFrame)
			local axis = rel:VectorToObjectSpace(Vector3.zAxis)
			local size = d.Size
			local ax, ay, az = math.abs(axis.X), math.abs(axis.Y), math.abs(axis.Z)
			if az >= ax and az >= ay then
				size = Vector3.new(size.X, size.Y, size.Z * s)
			elseif ax >= ay then
				size = Vector3.new(size.X * s, size.Y, size.Z)
			else
				size = Vector3.new(size.X, size.Y * s, size.Z)
			end
			d.Size = size
			local p = rel.Position
			d.CFrame = pivot * CFrame.new(p.X, p.Y, p.Z * s) * rel.Rotation
		end
	end
end

local function restyle(m: Model, band: string, room: string)
	local paint = ROOM_PAINT[room]
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local role = PART_ROLE[d.Name]
			if role == "Band" then
				apply(d, role, Color3.fromHex(BAND[band]))
			elseif role == "Olive" and paint then
				apply(d, role, Color3.fromHex(paint))
			elseif role then
				apply(d, role)
			end
		end
	end
end

-- The face of `part` that points most along the world direction `dir`.
local function faceToward(part: BasePart, dir: Vector3): Enum.NormalId
	local best, bestDot = Enum.NormalId.Front, -math.huge
	for _, n in Enum.NormalId:GetEnumItems() do
		local w = part.CFrame:VectorToWorldSpace(Vector3.FromNormalId(n))
		local dot = w:Dot(dir)
		if dot > bestDot then
			best, bestDot = n, dot
		end
	end
	return best
end

local function sign(part: BasePart, dir: Vector3, text: string): boolean
	local image = SIGN[text]
	if not image or image == "" then
		return false
	end
	for _, c in part:GetChildren() do
		if c:IsA("Decal") then
			c:Destroy()
		end
	end
	local d = Instance.new("Decal")
	d.Name = "SignArt"
	d.Face = faceToward(part, dir)
	d.Texture = "rbxassetid://" .. image
	d.Parent = part
	return true
end

local placed, signs = 0, 0
for i, s in PLACES do
	local x, y, z = s[3] :: number, s[4] :: number, s[5] :: number
	local m = put(sec(s[1] :: string), s[2] :: string, at(x, y, z, s[6] :: number))
	if i % 150 == 0 then
		task.wait()
	end
	if not m then
		continue
	end
	placed += 1
	stretch(m, s[7] :: number)
	restyle(m, bandKey(s[8] :: string, z), (s[10] or "") :: string)
	local piece = s[2] :: string
	local text = s[9] :: string
	local right = m:GetPivot().RightVector -- the piece's +X in the world
	if piece == "DoorLining" then
		local parts = string.split(text, "|")
		for k, part in { "DoorLining_SignP", "DoorLining_SignM" } do
			local p = m:FindFirstChild(part)
			if p and p:IsA("BasePart") then
				local label = parts[k] or ""
				if label == "" then
					p:Destroy() -- under a deck: no room for a sign
				elseif sign(p, if k == 1 then right else -right, label) then
					signs += 1
				end
			end
		end
	elseif piece == "SpawnPanel" then
		local p = m:FindFirstChild("SpawnPanel_Plate")
		if p and p:IsA("BasePart") and sign(p, right, "SPAWN " .. (if z > 0 then "B" else "A")) then
			signs += 1
		end
	elseif piece == "BlastDoor" then
		local p = m:FindFirstChild("BlastDoor_Sign")
		if p and p:IsA("BasePart") and sign(p, right, "GALLERY " .. (if z > 0 then "B" else "A")) then
			signs += 1
		end
	end
end

-- Greybox: hide what the kit replaced (collision stays), finish the rest by role.
local hidden, finished = 0, 0
for _, d in layer("Greybox"):GetDescendants() do
	if not d:IsA("BasePart") then
		continue
	end
	local art = d:GetAttribute("Art")
	local kind = d:GetAttribute("Kind")
	if art == "hide" then
		hide(d)
		if d.Name == "ShaftWall" then
			d.CastShadow = true -- invisible, still frames the sun
		end
		hidden += 1
		continue
	end
	local role: string? = nil
	if kind == "floor" then
		role = if art == "polished" then "FloorSun" else "Floor"
	elseif kind == "wall" then
		role = "Board"
	elseif kind == "roof" then
		role = "Ceiling"
	elseif kind == "deck" then
		role = "Deck"
	elseif kind == "low" then
		role = "BoardLight"
	elseif kind == "glass" then
		role = "Glass"
	end
	if role then
		apply(d, role)
		finished += 1
	end
end

local meshes = 0
for _, d in layer("Art"):GetDescendants() do
	if d:IsA("MeshPart") then
		meshes += 1
	end
end
root():SetAttribute("ArtMeshParts", meshes)
report(
	string.format(
		"Bunker2 art: %d of %d pieces placed, %d MeshParts, %d greybox parts hidden, %d finished, %d signs; %s",
		placed,
		#PLACES,
		meshes,
		hidden,
		finished,
		signs,
		missingReport()
	)
)
