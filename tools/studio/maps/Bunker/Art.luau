local function endColour(key: string, z: number): Color3
	if key == "B" then
		return BLUE
	elseif key == "A" then
		return YELLOW
	elseif key == "N" then
		return NEUTRAL
	end
	if math.abs(z) < 22 then
		return NEUTRAL -- the sunwell and the pump rooms belong to nobody
	end
	return if z > 0 then BLUE else YELLOW
end

-- Scales a placed piece along its own Z (its length): sizes along that axis and offsets from the pivot.
local function stretch(m: Model, s: number)
	if math.abs(s - 1) < 1e-4 then
		return
	end
	local pivot = m:GetPivot()
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(d.CFrame)
			local axis = rel:VectorToObjectSpace(Vector3.zAxis) -- the piece's Z in the part's own axes
			local size = d.Size
			local ax, ay, az = math.abs(axis.X), math.abs(axis.Y), math.abs(axis.Z)
			if az >= ax and az >= ay then
				size = Vector3.new(size.X, size.Y, size.Z * s)
			elseif ax >= ay then
				size = Vector3.new(size.X * s, size.Y, size.Z)
			else
				size = Vector3.new(size.X, size.Y * s, size.Z)
			end
			d.Size = size
			local p = rel.Position
			d.CFrame = pivot * CFrame.new(p.X, p.Y, p.Z * s) * rel.Rotation
		end
	end
end

local function tint(m: Model, colour: Color3)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local n = d.Name
			if string.sub(n, -5) == "_Band" or string.sub(n, -5) == "_Trim" then
				d.Color = colour
			end
		end
	end
end

-- The face of `part` that points most along the world direction `dir`.
local function faceToward(part: BasePart, dir: Vector3): Enum.NormalId
	local best, bestDot = Enum.NormalId.Front, -math.huge
	for _, n in Enum.NormalId:GetEnumItems() do
		local w = part.CFrame:VectorToWorldSpace(Vector3.FromNormalId(n))
		local dot = w:Dot(dir)
		if dot > bestDot then
			best, bestDot = n, dot
		end
	end
	return best
end

local function sign(part: BasePart, dir: Vector3, text: string, colour: Color3, pps: number)
	local face = faceToward(part, dir)
	local old = part:FindFirstChild("Sign_" .. face.Name)
	if old then
		old:Destroy()
	end
	local g = Instance.new("SurfaceGui")
	g.Name = "Sign_" .. face.Name
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps
	g.LightInfluence = 0.3
	g.Adornee = part
	g.Parent = part
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0.06, 0.12)
	t.Size = UDim2.fromScale(0.88, 0.76)
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = colour
	t.Parent = g
end

local placed, signs = 0, 0
for _, s in PLACES do
	local x, y, z = s[3] :: number, s[4] :: number, s[5] :: number
	local m = put(sec(s[1] :: string), s[2] :: string, at(x, y, z, s[6] :: number))
	if not m then
		continue
	end
	placed += 1
	stretch(m, s[7] :: number)
	local colour = endColour(s[8] :: string, z)
	tint(m, colour)
	local piece = s[2] :: string
	local text = s[9] :: string
	local right = m:GetPivot().RightVector -- the piece's +X in the world
	if piece == "DoorLining" then
		local parts = string.split(text, "|")
		for i, part in { "DoorLining_SignP", "DoorLining_SignM" } do
			local p = m:FindFirstChild(part)
			if p and p:IsA("BasePart") then
				local label = parts[i] or ""
				if label == "" then
					p:Destroy() -- under a deck: no room for a sign
				else
					sign(p, if i == 1 then right else -right, label, WHITE, 40)
					signs += 1
				end
			end
		end
	elseif piece == "SpawnPanel" then
		local p = m:FindFirstChild("SpawnPanel_Plate")
		if p and p:IsA("BasePart") then
			sign(p, right, text, colour, 12)
			signs += 1
		end
	elseif piece == "BlastDoor" then
		local p = m:FindFirstChild("BlastDoor_Trim")
		if p and p:IsA("BasePart") then
			sign(p, right, (if z > 0 then "B" else "A") .. "  ·  GALLERY", INK, 30)
			signs += 1
		end
	end
end

-- Greybox: hide what the kit replaced (collision stays), finish the rest.
type Finish = { material: Enum.Material, color: Color3 }
local function F(material: Enum.Material, hex: string): Finish
	return { material = material, color = Color3.fromHex(hex) }
end
local FLOOR_SUN = F(Enum.Material.Concrete, "B9B4AA")
local FLOOR = F(Enum.Material.Concrete, "55565A")
local WALL = F(Enum.Material.Concrete, "6B6965") -- behind the cladding: its seams and the lintels
local CEILING = F(Enum.Material.Concrete, "7A7873")
local CEILING_HALL = F(Enum.Material.Concrete, "8E8C87")
local DECK = F(Enum.Material.Concrete, "8E8C87")
local PARAPET = F(Enum.Material.Concrete, "9A968F")

local hidden, finished = 0, 0
for _, d in layer("Greybox"):GetDescendants() do
	if not d:IsA("BasePart") then
		continue
	end
	local art = d:GetAttribute("Art")
	local kind = d:GetAttribute("Kind")
	if art == "hide" then
		hide(d)
		if d.Name == "ShaftWall" then
			d.CastShadow = true -- invisible, still frames the sun
		end
		hidden += 1
		continue
	end
	local f: Finish? = nil
	if kind == "floor" then
		f = if art == "polished" then FLOOR_SUN else FLOOR
	elseif kind == "wall" then
		f = WALL
	elseif kind == "roof" then
		local parent = d.Parent
		f = if parent and (parent.Name == "Sunwell" or parent.Name == "Gallery")
			then CEILING_HALL
			else CEILING
	elseif kind == "deck" then
		f = DECK
	elseif kind == "low" then
		f = PARAPET
	end
	if f then
		d.Material = f.material
		d.Color = f.color
		finished += 1
	end
end

report(
	string.format(
		"Bunker art: %d pieces placed, %d greybox parts hidden, %d finished, %d signs; %s",
		placed,
		hidden,
		finished,
		signs,
		missingReport()
	)
)
