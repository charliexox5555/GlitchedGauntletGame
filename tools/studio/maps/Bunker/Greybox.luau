-- { section, name, x0, x1, y0, y1, z0, z1, up } ramps; up = +1 rises toward +Z.
local RAMPS: { { any } } = {
	{ "Gallery", "GalleryStair", 6, 12, 0, 12, 30, 48, -1 },
	{ "Gallery", "GalleryStair", -12, -6, 0, 12, -48, -30, 1 },
}

