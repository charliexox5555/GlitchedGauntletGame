--!strict
-- Bunker2 lighting (vault/01 Design/Maps/Bunker2.md -> Identity, Light): bright readable shade everywhere, warm coves,
-- one hot column of sun on the gold-capped plinth. Values live in tools/maps/bunker2_style.py (the LIGHT block).
-- Bundle after the greybox and the art (it needs Workspace.Bunker2):
--   python tools/studio/maps/bundle.py Bunker2 Greybox Art Lighting -o bunker2.luau
-- Builds, inside Workspace.Bunker2:
--   Lighting     a Configuration whose attributes are Lighting properties (MapService applies them on load)
--   LightingFx   Sky, Atmosphere, Bloom, ColorCorrection, SunRays for the map
--   Art.Lighting the sunbeam rig in the shaft, shaft dust, a warm bounce off the dais, and shadowless room lights
-- Sun: GeographicLatitude 23.5 with ClockTime 12 puts the sun at the zenith, so the beam falls straight down the
-- 24-wide shaft onto the dais, the same for both teams. Re-runnable. Tip: Lighting.Technology should be Future.

-- BEGIN LIGHT (generated by tools/maps/bunker2_style.py --luau; edit the values there)
-- stylua: ignore start
local PROPS: { [string]: any } = {
	ClockTime = 12,
	GeographicLatitude = 23.5,
	Brightness = 3,
	Ambient = Color3.fromRGB(150, 148, 146),
	OutdoorAmbient = Color3.fromRGB(140, 140, 146),
	ColorShift_Top = Color3.fromRGB(255, 240, 220),
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
	EnvironmentDiffuseScale = 0.15,
	EnvironmentSpecularScale = 0.1,
	ExposureCompensation = 0,
	GlobalShadows = true,
	ShadowSoftness = 0.15,
}
local FX: { [string]: { [string]: any } } = {
	Atmosphere = { Density = 0.28, Offset = 0, Color = Color3.fromRGB(214, 200, 180), Decay = Color3.fromRGB(120, 112, 102), Glare = 0, Haze = 1.2 },
	Bloom = { Intensity = 0.55, Size = 24, Threshold = 1.1 },
	Grade = { Brightness = 0, Contrast = 0.16, Saturation = -0.08, TintColor = Color3.fromRGB(255, 250, 244) },
	SunRays = { Intensity = 0.07, Spread = 0.5 },
}
local LAMP = { color = Color3.fromRGB(255, 238, 214), brightness = 0.75, range = 24 }
-- stylua: ignore end
-- END LIGHT

newMap("Bunker2", CFrame.new(-3000, 200, 1500))
local map = root()

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

local old = map:FindFirstChild("Lighting")
if old then
	old:Destroy()
end
local config = Instance.new("Configuration")
config.Name = "Lighting"
local nProps = 0
for k, v in PROPS do
	config:SetAttribute(k, v)
	nProps += 1
end
config.Parent = map

local oldFx = map:FindFirstChild("LightingFx")
if oldFx then
	oldFx:Destroy()
end
local fx = Instance.new("Folder")
fx.Name = "LightingFx"
fx.Parent = map

local sky = Instance.new("Sky")
sky.Name = "Bunker2Sky"
sky.SunAngularSize = 12
sky.StarCount = 0
sky.CelestialBodiesShown = true
sky.Parent = fx

local function set(inst: Instance, props: { [string]: any })
	for k, v in props do
		(inst :: any)[k] = v
	end
end

local atmo = Instance.new("Atmosphere")
set(atmo, FX.Atmosphere)
atmo.Parent = fx
local bloom = Instance.new("BloomEffect")
set(bloom, FX.Bloom)
bloom.Parent = fx
local grade = Instance.new("ColorCorrectionEffect")
set(grade, FX.Grade)
grade.Parent = fx
local rays = Instance.new("SunRaysEffect")
set(rays, FX.SunRays)
rays.Parent = fx

-- Local light rig.
local folder = section("Art", "Lighting")
local SUN = hex("FFE2B8")
local count = 0

local function anchor(name: string, x: number, y: number, z: number, size: Vector3?): BasePart
	local a = box(folder, name, size or Vector3.new(0.2, 0.2, 0.2), at(x, y, z), SUN, {
		transparency = 1,
		castShadow = false,
	})
	decor(a)
	a:SetAttribute("AllowFloat", true) -- an invisible light anchor, not geometry
	return a
end

local function point(name: string, x: number, y: number, z: number, colour: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = colour
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = anchor(name, x, y, z)
	count += 1
end

-- The sunbeam: two nested camera-facing ribbons from just under the skylight to the dais (the Lobby's textures).
local IMG_SUNBEAM = "rbxassetid://122394313975001"
local IMG_MOTE = "rbxassetid://139664604115042"
local beamPart = anchor("SunBeam", 0, 32, 0)
local top = Instance.new("Attachment")
top.Name = "Top"
top.Parent = beamPart
top.WorldPosition = W(CFrame.new(0, 62.5, 0)).Position
local bottom = Instance.new("Attachment")
bottom.Name = "Floor"
bottom.Parent = beamPart
bottom.WorldPosition = W(CFrame.new(0, 0.6, 0)).Position
-- v1 r2: no Beams (camera-facing ribbons read as an outlined flat sheet in captures, as in the Lobby).
local _ = { top, bottom, IMG_SUNBEAM }

local dustBox = anchor("SunDust", 0, 22, 0, Vector3.new(20, 40, 20))
local dust = Instance.new("ParticleEmitter")
dust.Texture = IMG_MOTE
dust.Shape = Enum.ParticleEmitterShape.Box
dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
dust.Rate = 5
dust.Lifetime = NumberRange.new(8, 12)
dust.Speed = NumberRange.new(0.1, 0.4)
dust.SpreadAngle = Vector2.new(180, 180)
dust.Size = NumberSequence.new(0.18)
dust.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.2, 0.45),
	NumberSequenceKeypoint.new(0.8, 0.45),
	NumberSequenceKeypoint.new(1, 1),
})
dust.LightEmission = 0.6
dust.Color = ColorSequence.new(SUN)
dust.Parent = dustBox

-- Bounce: a warm, shadowless SurfaceLight on the sunlit dais (Roblox has no GI).
local bouncePart = anchor("SunBounce", 0, 0.7, 0, Vector3.new(16, 0.1, 16))
local bounce = Instance.new("SurfaceLight")
bounce.Face = Enum.NormalId.Top
bounce.Angle = 90
bounce.Range = 20
bounce.Brightness = 0.3 -- v1 r1: 1.2 blew the ring underside to white
bounce.Color = SUN
bounce.Shadows = false
bounce.Parent = bouncePart
count += 1

-- Room lights, all shadowless, warm (the coves' colour): team B's half and the east pump; team A's is the 180° turn.
local LAMP_C = LAMP.color :: Color3
for _, s in { 1, -1 } do
	point("CorridorEast", s * 36, 9, s * 34, LAMP_C, LAMP.range, LAMP.brightness)
	point("CorridorWest", -s * 36, 9, s * 34, LAMP_C, LAMP.range, LAMP.brightness)
	point("Lockers", s * 22, 9, s * 36, LAMP_C, LAMP.range, LAMP.brightness)
	point("Control", -s * 22, 9, s * 36, LAMP_C, LAMP.range, LAMP.brightness)
	point("Vestibule", 0, 9, s * 60, LAMP_C, 30, LAMP.brightness)
	point("Spawn", 0, 9, s * 84, LAMP_C, 28, LAMP.brightness)
	point("Gallery", 0, 20, s * 42, LAMP_C, 30, LAMP.brightness)
	point("Pump", s * 28, 9, 0, LAMP_C, LAMP.range, LAMP.brightness)
end

report(
	string.format(
		"Bunker2 lighting: Lighting config (%d props), LightingFx (5), sunbeam + dust, %d shadowless lights",
		nProps,
		count
	)
)
