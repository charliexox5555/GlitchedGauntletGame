-- END ART

local map = newMap("Dockyard", CFrame.new(-1500, 200, 0))
local greybox = layer("Greybox")

local function shade(c: Color3, k: number): Color3
	return Color3.new(math.min(c.R * k, 1), math.min(c.G * k, 1), math.min(c.B * k, 1))
end

-- Lane tint on a kit model: *_Body and *_Stripe take the colour, *_Frame a darker step.
local function tint(m: Model?, color: Color3)
	if not m then
		return
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local n = d.Name
			if string.sub(n, -5) == "_Body" or string.sub(n, -7) == "_Stripe" then
				d.Color = color
			elseif string.sub(n, -6) == "_Frame" then
				d.Color = shade(color, 0.8)
			end
		end
	end
end

local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Art", name)
		sections[name] = f
	end
	return f
end
-- Fresh sections even when a list is empty (a re-run never leaves stale art behind).
for _, name in { "Containers", "Yard", "Sheds", "Crane", "Quay", "EndWalls", "Skyline", "Deck" } do
	sec(name)
end

-- Kit pieces. ok[id] stays true while every placement owning greybox part `id` succeeds.
local ok: { [number]: boolean } = {}
local placed = 0
for _, a in ART do
	local m = put(sec(a.sec), a.piece, at(a.x, a.y, a.z, a.yaw))
	if m and a.tint then
		tint(m, Color3.fromHex(a.tint))
	end
	if m then
		placed += 1
	end
	for _, id in a.own do
		ok[id] = (ok[id] ~= false) and m ~= nil
	end
end

-- Art Parts: deck paint, end-wall fillers, water, far quays. Decor only.
for _, q in PARTS do
	local p = box(
		sec(q.sec),
		q.name,
		Vector3.new(q.size[1], q.size[2], q.size[3]),
		at(q.pos[1], q.pos[2], q.pos[3]),
		Color3.fromHex(q.color),
		{ material = (Enum.Material :: any)[q.material], castShadow = false }
	)
	p.Reflectance = q.reflectance
	decor(p)
end

-- Hide what the art replaced; recolour the deck (it stays visible and collides).
local hidden = 0
for _, d in greybox:GetDescendants() do
	if d:IsA("BasePart") then
		local id = d:GetAttribute("Id")
		if typeof(id) == "number" and ok[id] then
			hide(d)
			hidden += 1
		elseif d:GetAttribute("Kind") == "deck" then
			d.Color = Color3.fromRGB(74, 74, 76)
			d.Material = Enum.Material.Asphalt
		end
	end
end

-- Shed name boards over the roller doors (a see-through Part carrying the SurfaceGui).
for _, s in { 1, -1 } do
	local key = if s > 0 then "B" else "A"
	local board = box(
		sec("Sheds"),
		"ShedName_" .. key,
		Vector3.new(12.6, 2.8, 0.1),
		at(55 * s, 17.1, 23.25 * s, if s > 0 then 0 else 180),
		Color3.new(0, 0, 0),
		{ transparency = 1, castShadow = false }
	)
	decor(board)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0.35
	gui.Brightness = 1.5
	gui.PixelsPerStud = 40
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(240, 232, 214)
	label.Text = if s > 0 then "GREEN SHED" else "RED SHED"
	label.Parent = gui
	gui.Parent = board
end

local meshes = 0
for _, d in layer("Art"):GetDescendants() do
	if d:IsA("MeshPart") then
		meshes += 1
	end
end
map:SetAttribute("ArtMeshParts", meshes)
report(
	string.format(
		"Dockyard art: %d kit placements, %d art parts, %d greybox parts hidden, %d MeshParts; %s",
		placed,
		#PARTS,
		hidden,
		meshes,
		missingReport()
	)
)
