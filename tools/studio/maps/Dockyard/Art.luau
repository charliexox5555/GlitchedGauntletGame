--!strict
-- Dockyard art pass (vault/01 Design/Maps/Dockyard.md): dresses the greybox with the Blender kit.
-- Needs: the greybox (Greybox.luau) and the kit installed in ServerStorage.MapKit.Dockyard
-- (python tools/studio/maps/kit_bundle.py Dockyard Kit). Bundle:
--   python tools/studio/maps/bundle.py Dockyard Art Lighting -o dockyard_art.luau
-- and run it in the match place, edit mode. Re-runnable: every Art section is rebuilt.
--
-- What goes where is the ART / PARTS block below, generated from tools/maps/dockyard_art.py
-- (python tools/maps/dockyard_layout.py --luau). The Blender build assembles the same list
-- for its previews and checks it for z-fighting (coplanar overlapping faces) before export,
-- so edit placements there, never here. A greybox part (attribute Id = its LAYOUT index) is
-- hidden once every placement that dresses it (`own`) was placed; it stays the collision.
-- When a kit piece is missing the greybox stays visible and the report lists the piece.

type Put = {
	piece: string,
	sec: string,
	x: number,
	y: number,
	z: number,
	yaw: number,
	tint: string?,
	own: { number },
}
type ArtPart = {
	name: string,
	sec: string,
	size: { number },
	pos: { number },
	color: string,
	material: string,
	reflectance: number,
}

