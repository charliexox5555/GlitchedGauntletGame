--!strict
-- Dockyard2 art pass (vault/01 Design/Maps/Dockyard2.md): dresses the greybox with the Blender kit and
-- applies the map's style by role. Needs the greybox (Greybox.luau) and the kit in
-- ServerStorage.MapKit.Dockyard2 (python tools/studio/maps/kit_bundle.py Dockyard2 Kit). Bundle:
--   python tools/studio/maps/bundle.py Dockyard2 Art Lighting -o dockyard2_art.luau
-- and run it in the match place, edit mode. Re-runnable: every Art section is rebuilt.
--
-- Two generated blocks, never edited here:
--   STYLE  colours / materials / MaterialVariants by role, from tools/maps/dockyard2_style.py --luau
--          (a restyle is: edit that file, regenerate, rerun this bundle; no Blender, no upload);
--   ART    what goes where, from tools/maps/dockyard2_art.py (python tools/maps/dockyard2_layout.py --luau).
-- A greybox part (attribute Id = its LAYOUT index) is hidden once every placement that dresses it (`own`)
-- was placed; it stays the collision. A missing kit piece leaves the greybox visible and is reported.

type RoleLook = { color: string, material: string, variant: string }
type Put = {
	piece: string,
	sec: string,
	x: number,
	y: number,
	z: number,
	yaw: number,
	lane: string?,
	own: { number },
}
type ArtPart = {
	name: string,
	sec: string,
	size: { number },
	pos: { number },
	role: string,
	reflectance: number,
}

