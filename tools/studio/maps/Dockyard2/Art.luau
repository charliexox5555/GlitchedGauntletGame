local MaterialService = game:GetService("MaterialService")

local map = newMap("Dockyard2", CFrame.new(-3000, 200, 0))
local greybox = layer("Greybox")

-- The Dock2_* MaterialVariants (the Lobby's painted textures; BasePart.Color sets the hue).
for name, v in VARIANTS do
	local found = MaterialService:FindFirstChild(name)
	local mv: MaterialVariant
	if found and found:IsA("MaterialVariant") then
		mv = found
	else
		mv = Instance.new("MaterialVariant")
		mv.Name = name
		mv.Parent = MaterialService
	end
	mv.BaseMaterial = (Enum.Material :: any)[v[1]]
	mv.StudsPerTile = v[2]
	mv.ColorMap = "rbxassetid://" .. v[3]
	mv.NormalMap = "rbxassetid://" .. v[4]
	mv.RoughnessMap = "rbxassetid://" .. v[5]
	mv.MaterialPattern = Enum.MaterialPattern.Regular
end

local function apply(part: BasePart, role: string, color: Color3?)
	local look = ROLE[role]
	if not look then
		return
	end
	part.Color = color or Color3.fromHex(look.color)
	if look.material == "Neon" or part:GetAttribute("Glow") then
		part.Material = Enum.Material.Neon
		return
	end
	part.Material = (Enum.Material :: any)[look.material]
	part.MaterialVariant = look.variant
	if look.material == "Glass" then
		part.Transparency = 0.5
	end
end

-- Lane colour of a placement: a LANE key or "bd<n>" (BACKDROP, 0-based).
local function laneColor(lane: string?): Color3?
	if not lane then
		return nil
	end
	local hex = LANE[lane]
	if not hex and string.sub(lane, 1, 2) == "bd" then
		hex = BACKDROP[(tonumber(string.sub(lane, 3)) or 0) + 1]
	end
	return if hex then Color3.fromHex(hex) else nil
end

-- Restyles a placed kit piece by role; Lane / LaneFrame parts take the placement's lane colour.
local function restyle(m: Instance, lane: string?)
	local c = laneColor(lane)
	for _, d in m:GetDescendants() do
		if not d:IsA("BasePart") then
			continue
		end
		local role = PART_ROLE[d.Name]
		if not role then
			continue
		end
		if c and role == "Lane" then
			apply(d, role, c)
		elseif c and role == "LaneFrame" then
			local k = FRAME_SHADE
			apply(d, role, Color3.new(c.R * k, c.G * k, c.B * k))
		else
			apply(d, role)
		end
	end
end

local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Art", name)
		sections[name] = f
	end
	return f
end
-- Fresh sections even when a list is empty (a re-run never leaves stale art behind).
for _, name in { "Containers", "Yard", "Sheds", "Crane", "Quay", "EndWalls", "Skyline", "Deck", "Spawn" } do
	sec(name)
end

-- Kit pieces. ok[id] stays true while every placement owning greybox part `id` succeeds.
local ok: { [number]: boolean } = {}
local placed = 0
for i, a in ART do
	local m = put(sec(a.sec), a.piece, at(a.x, a.y, a.z, a.yaw))
	if m then
		restyle(m, a.lane)
		placed += 1
	end
	for _, id in a.own do
		ok[id] = (ok[id] ~= false) and m ~= nil
	end
	if i % 150 == 0 then
		task.wait()
	end
end

-- Art Parts: deck paint, end-wall fillers, water, far quays. Decor only.
for _, q in ART_PARTS do
	local p = box(
		sec(q.sec),
		q.name,
		Vector3.new(q.size[1], q.size[2], q.size[3]),
		at(q.pos[1], q.pos[2], q.pos[3]),
		Color3.new(1, 1, 1),
		{ castShadow = false }
	)
	apply(p, q.role)
	p.Reflectance = q.reflectance
	decor(p)
end

-- Hide what the art replaced; the deck stays visible (and collides) in its role's look.
local hidden = 0
for _, d in greybox:GetDescendants() do
	if d:IsA("BasePart") then
		local id = d:GetAttribute("Id")
		if typeof(id) == "number" and ok[id] then
			hide(d)
			hidden += 1
		elseif d:GetAttribute("Kind") == "deck" then
			apply(d, "Deck")
		end
	end
end

local meshes = 0
for _, d in layer("Art"):GetDescendants() do
	if d:IsA("MeshPart") then
		meshes += 1
	end
end
map:SetAttribute("ArtMeshParts", meshes)
report(
	string.format(
		"Dockyard2 art: %d kit placements, %d art parts, %d greybox parts hidden, %d MeshParts; %s",
		placed,
		#ART_PARTS,
		hidden,
		meshes,
		missingReport()
	)
)
