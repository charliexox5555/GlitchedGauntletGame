local DECK_X = 68 -- deck half width (the harbour beyond)
local DECK_Z = 118 -- deck half length (under the end container walls)
local DECK_T = 4 -- deck thickness

-- Greybox colours: muted lane hues so the greybox already reads by lane.
local LANE_COLOR: { [string]: Color3 } = {
	west = Color3.fromRGB(140, 84, 74),
	mid = Color3.fromRGB(84, 108, 140),
	east = Color3.fromRGB(88, 124, 96),
	neutral = Color3.fromRGB(150, 150, 154),
}
local KIND_COLOR: { [string]: Color3 } = {
	low = Color3.fromRGB(176, 158, 120),
	wall = Color3.fromRGB(120, 122, 128),
	office = Color3.fromRGB(138, 140, 146),
	rack = Color3.fromRGB(150, 126, 90),
	pillar = Color3.fromRGB(214, 168, 54),
	beam = Color3.fromRGB(214, 168, 54),
	ramp = Color3.fromRGB(176, 180, 190),
	roof = Color3.fromRGB(110, 112, 118),
	lintel = Color3.fromRGB(120, 122, 128),
	edge = Color3.fromRGB(168, 166, 160),
	backdrop = Color3.fromRGB(96, 98, 104),
}
local SECTION_OF: { [string]: string } = {
	box = "Containers",
	low = "Cover",
	ramp = "Ramps",
	wall = "Shed",
	office = "Shed",
	rack = "Shed",
	roof = "Shed",
	lintel = "Shed",
	pillar = "Crane",
	beam = "Crane",
	edge = "Edges",
	backdrop = "EndWalls",
}

local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Greybox", name)
		sections[name] = f
	end
	return f
end

local currentId = 0
local function tag(part: BasePart, p: Piece, half: string)
	part:SetAttribute("Id", currentId) -- the LAYOUT index Art.luau's placements refer to
	part:SetAttribute("Kind", p.kind)
	part:SetAttribute("Lane", p.lane)
	part:SetAttribute("Half", half)
	if p.piece then
		part:SetAttribute("Piece", p.piece)
	end
	if p.piece == "C40" or p.piece == "C20" then
		part:SetAttribute("Stack", math.floor(p.h / 8 + 0.5))
	end
end

-- The deck: one slab, its top at y = 0.
local deck = box(
	sec("Deck"),
	"Deck",
	Vector3.new(DECK_X * 2, DECK_T, DECK_Z * 2),
	at(0, -DECK_T / 2, 0),
	Color3.fromRGB(150, 146, 138),
	{ material = Enum.Material.Concrete }
)
deck:SetAttribute("Kind", "deck")

local count = 0
for i, p in LAYOUT do
	currentId = i
	local half = if p.z > 0.01 then "B" elseif p.z < -0.01 then "A" else "C"
	local folder = sec(SECTION_OF[p.kind] or "Containers")
	local color = KIND_COLOR[p.kind] or LANE_COLOR[p.lane] or LANE_COLOR.neutral
	local look: Look = {
		material = if p.kind == "box"
				or p.kind == "backdrop"
				or p.kind == "wall"
				or p.kind == "roof"
			then Enum.Material.Metal
			else Enum.Material.SmoothPlastic,
		castShadow = p.h >= 6,
	}
	if p.kind == "ramp" then
		local up = p.up :: { number }
		local yaw = math.deg(math.atan2(up[1], up[2]))
		-- Width across the climb, length along it (the wedge rises toward its local +Z).
		local along = math.abs(up[1]) * p.sx + math.abs(up[2]) * p.sz
		local across = math.abs(up[2]) * p.sx + math.abs(up[1]) * p.sz
		local w = wedge(
			folder,
			p.name,
			Vector3.new(across, p.h, along),
			at(p.x, p.y0 + p.h / 2, p.z, yaw),
			color,
			look
		)
		tag(w, p, half)
		count += 1
	elseif p.kind == "roof" then
		-- Gable, ridge along Z: two wedges rising toward the middle from the long walls.
		for _, side in { -1, 1 } do
			local w = wedge(
				folder,
				p.name,
				Vector3.new(p.sz, p.h, p.sx / 2),
				at(p.x + side * p.sx / 4, p.y0 + p.h / 2, p.z, if side < 0 then 90 else -90),
				color,
				look
			)
			tag(w, p, half)
			count += 1
		end
	else
		local b = box(
			folder,
			p.name,
			Vector3.new(p.sx, p.h, p.sz),
			at(p.x, p.y0 + p.h / 2, p.z),
			color,
			look
		)
		tag(b, p, half)
		count += 1
	end
end

-- Spawns (4 per team, facing the centre) and the barriers across the alcove mouths.
spawnsClear()
for i, s in SPAWNS_A do
	spawnPad("A", i, at(s[1], 0, s[2], 180))
end
for i, s in SPAWNS_B do
	spawnPad("B", i, at(s[1], 0, s[2], 0))
end
barrier("Barrier_A", Vector3.new(36, 30, 1), at(0, 15, -92))
barrier("Barrier_B", Vector3.new(36, 30, 1), at(0, 15, 92))

map:SetAttribute("Layout", "tools/maps/dockyard2_layout.py")
report(
	string.format(
		"Dockyard2 greybox: deck + %d parts, %d + %d spawns, 2 barriers",
		count,
		#SPAWNS_A,
		#SPAWNS_B
	)
)
