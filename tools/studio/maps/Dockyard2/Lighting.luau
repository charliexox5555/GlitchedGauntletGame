--!strict
-- Dockyard2 lighting (vault/01 Design/Maps/Dockyard2.md -> Look): a bright afternoon over the harbour.
-- MapService applies the map's "Lighting" Configuration (attributes = Lighting properties) and its
-- "LightingFx" folder (Sky, Atmosphere, effects) when the map loads, and restores the place's own
-- lighting afterwards. Bundle with Art: bundle.py Dockyard2 Art Lighting.
--
-- The LIGHT block is generated from tools/maps/dockyard2_style.py (LIGHTING, FX, LAMP); change the values
-- there and run python tools/maps/dockyard2_style.py --luau. LihFolk Stylized Lighting Recipes §3.1
-- ("Bright cartoon") is the base. GeographicLatitude 0 puts the sun's path in the X/Y plane, so at
-- ClockTime 15 it stands ~45 deg up over +X: it rakes across the pier and neither team looks into it.
-- Local lights: only inside the Sheds (shadowless), where the roof shades the close-range fights.
-- To see it: playtest with Workspace ForceMap = "Dockyard2" (this never touches the Lighting service).

-- BEGIN LIGHT (generated by tools/maps/dockyard2_style.py --luau; edit the values there)
-- stylua: ignore start
local PROPS: { [string]: any } = {
	ClockTime = 15,
	GeographicLatitude = 0,
	Brightness = 2.6,
	Ambient = Color3.fromRGB(104, 108, 122),
	OutdoorAmbient = Color3.fromRGB(142, 148, 164),
	ColorShift_Top = Color3.fromRGB(255, 236, 206),
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
	EnvironmentDiffuseScale = 0.35,
	EnvironmentSpecularScale = 0.15,
	ExposureCompensation = 0.1,
	GlobalShadows = true,
	ShadowSoftness = 0.2,
}
local FX: { [string]: { [string]: any } } = {
	Atmosphere = { Density = 0.28, Offset = 0.15, Color = Color3.fromRGB(199, 222, 240), Decay = Color3.fromRGB(124, 162, 200), Glare = 0.1, Haze = 0.6 },
	Bloom = { Intensity = 0.45, Size = 24, Threshold = 1.4 },
	Grade = { Brightness = 0.02, Contrast = 0.1, Saturation = 0.12, TintColor = Color3.fromRGB(255, 251, 244) },
	SunRays = { Intensity = 0.04, Spread = 0.5 },
}
local LAMP = { color = Color3.fromRGB(255, 226, 184), brightness = 1.2, range = 40 }
-- stylua: ignore end
-- END LIGHT

local map = newMap("Dockyard2", CFrame.new(-3000, 200, 0))

local old = map:FindFirstChild("Lighting")
if old then
	old:Destroy()
end
local config = Instance.new("Configuration")
config.Name = "Lighting"
for name, value in PROPS do
	config:SetAttribute(name, value)
end
config.Parent = map

local oldFx = map:FindFirstChild("LightingFx")
if oldFx then
	oldFx:Destroy()
end
local fx = Instance.new("Folder")
fx.Name = "LightingFx"

local sky = Instance.new("Sky")
sky.Name = "HarbourSky"
sky.CelestialBodiesShown = true
sky.SunAngularSize = 14
sky.StarCount = 0
sky.Parent = fx

local function set(inst: Instance, props: { [string]: any })
	for k, v in props do
		(inst :: any)[k] = v
	end
end

local atmosphere = Instance.new("Atmosphere")
set(atmosphere, FX.Atmosphere)
atmosphere.Parent = fx
local bloom = Instance.new("BloomEffect")
set(bloom, FX.Bloom)
bloom.Parent = fx
local grade = Instance.new("ColorCorrectionEffect")
set(grade, FX.Grade)
grade.Parent = fx
local rays = Instance.new("SunRaysEffect")
set(rays, FX.SunRays)
rays.Parent = fx
fx.Parent = map

-- Shed lamps: warm, shadowless PointLights under the pendants (the kit's LampGlow).
local lights = section("Art", "Lights")
local count = 0
for _, s in { 1, -1 } do
	for _, l in { { -5, -7.5 }, { 5, 7.5 } } do
		local p = box(
			lights,
			"ShedLight",
			Vector3.new(0.4, 0.4, 0.4),
			at(55 * s + l[1] * s, 11.5, 42 * s + l[2] * s),
			LAMP.color,
			{ transparency = 1, castShadow = false }
		)
		decor(p)
		local light = Instance.new("PointLight")
		light.Range = LAMP.range
		light.Brightness = LAMP.brightness
		light.Color = LAMP.color
		light.Shadows = false
		light.Parent = p
		count += 1
	end
end

report(
	string.format(
		"Dockyard2 lighting: ClockTime %.2f, %d effects, %d lights (shadowless)",
		PROPS.ClockTime,
		#fx:GetChildren(),
		count
	)
)
