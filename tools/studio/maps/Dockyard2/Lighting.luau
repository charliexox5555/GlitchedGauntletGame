--!strict
-- Dockyard2 lighting (vault/01 Design/Maps/Dockyard2.md -> Look): a bright afternoon over the harbour.
-- MapService applies the map's "Lighting" Configuration (attributes = Lighting properties) and its
-- "LightingFx" folder (Sky, Atmosphere, effects) when the map loads, and restores the place's own
-- lighting afterwards. Bundle with Art: bundle.py Dockyard2 Art Lighting.
--
-- The LIGHT block is generated from tools/maps/dockyard2_style.py (LIGHTING, FX, LAMP); change the values
-- there and run python tools/maps/dockyard2_style.py --luau. LihFolk Stylized Lighting Recipes §3.1
-- ("Bright cartoon") is the base. GeographicLatitude 23.5 at ClockTime 15 puts the sun 45 deg up over -X
-- (GetSunDirection (-0.71, 0.71, 0.0), measured): it rakes across the pier and neither team looks into it.
-- Local lights: only inside the Sheds (shadowless), where the roof shades the close-range fights.
-- To see it: playtest with Workspace ForceMap = "Dockyard2" (this never touches the Lighting service).

-- BEGIN LIGHT (generated by tools/maps/dockyard2_style.py --luau; edit the values there)
-- stylua: ignore start
local PROPS: { [string]: any } = {
	ClockTime = 16.3,
	GeographicLatitude = 23.5,
	Brightness = 3,
	Ambient = Color3.fromRGB(140, 142, 152),
	OutdoorAmbient = Color3.fromRGB(178, 180, 194),
	ColorShift_Top = Color3.fromRGB(255, 214, 172),
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
	EnvironmentDiffuseScale = 0.2,
	EnvironmentSpecularScale = 0.15,
	ExposureCompensation = 0.2,
	GlobalShadows = true,
	ShadowSoftness = 0.2,
}
local FX: { [string]: { [string]: any } } = {
	Atmosphere = { Density = 0.3, Offset = 0.18, Color = Color3.fromRGB(234, 220, 202), Decay = Color3.fromRGB(140, 176, 216), Glare = 0.6, Haze = 1.6 },
	Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.25 },
	Grade = { Brightness = 0.03, Contrast = 0.13, Saturation = 0.12, TintColor = Color3.fromRGB(255, 244, 228) },
	SunRays = { Intensity = 0.08, Spread = 0.5 },
}
local LAMP = { color = Color3.fromRGB(255, 222, 176), brightness = 1.7, range = 36 }
-- stylua: ignore end
-- END LIGHT

local map = newMap("Dockyard2", CFrame.new(-3000, 200, 0))

local old = map:FindFirstChild("Lighting")
if old then
	old:Destroy()
end
local config = Instance.new("Configuration")
config.Name = "Lighting"
for name, value in PROPS do
	config:SetAttribute(name, value)
end
config.Parent = map

local oldFx = map:FindFirstChild("LightingFx")
if oldFx then
	oldFx:Destroy()
end
local fx = Instance.new("Folder")
fx.Name = "LightingFx"

-- Maps v5 round 2: our harbour-day skybox (tools/textures/make_dusk_sky.py dock; clear blue zenith, warm pale
-- haze, white clouds, from the concept). Image ids: the Decal uploads resolved in Studio.
local SKY = {
	Bk = "rbxassetid://102637424570355",
	Ft = "rbxassetid://108516501181725",
	Lf = "rbxassetid://122502844689934",
	Rt = "rbxassetid://109028810530264",
	Up = "rbxassetid://101311805128999",
	Dn = "rbxassetid://71458001248875",
}
local sky = Instance.new("Sky")
sky.Name = "HarbourSky"
sky.SkyboxBk = SKY.Bk
sky.SkyboxFt = SKY.Ft
sky.SkyboxLf = SKY.Lf
sky.SkyboxRt = SKY.Rt
sky.SkyboxUp = SKY.Up
sky.SkyboxDn = SKY.Dn
sky.CelestialBodiesShown = true
sky.SunAngularSize = 14
sky.StarCount = 0
sky.Parent = fx

local function set(inst: Instance, props: { [string]: any })
	for k, v in props do
		(inst :: any)[k] = v
	end
end

local atmosphere = Instance.new("Atmosphere")
set(atmosphere, FX.Atmosphere)
atmosphere.Parent = fx
local bloom = Instance.new("BloomEffect")
set(bloom, FX.Bloom)
bloom.Parent = fx
local grade = Instance.new("ColorCorrectionEffect")
set(grade, FX.Grade)
grade.Parent = fx
local rays = Instance.new("SunRaysEffect")
set(rays, FX.SunRays)
rays.Parent = fx
fx.Parent = map

-- Shed lamps: warm, shadowless PointLights under the pendants (the kit's LampGlow).
local lights = section("Art", "Lights")
local count = 0
for _, s in { 1, -1 } do
	for _, l in { { -5, -7.5 }, { 5, 7.5 } } do
		local p = box(
			lights,
			"ShedLight",
			Vector3.new(0.4, 0.4, 0.4),
			at(55 * s + l[1] * s, 11.5, 42 * s + l[2] * s),
			LAMP.color,
			{ transparency = 1, castShadow = false }
		)
		decor(p)
		local light = Instance.new("PointLight")
		light.Range = LAMP.range
		light.Brightness = LAMP.brightness
		light.Color = LAMP.color
		light.Shadows = false
		light.Parent = p
		count += 1
	end
end

report(
	string.format(
		"Dockyard2 lighting: ClockTime %.2f, %d effects, %d lights (shadowless)",
		PROPS.ClockTime,
		#fx:GetChildren(),
		count
	)
)
