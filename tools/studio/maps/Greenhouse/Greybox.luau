local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Greybox", name)
		sections[name] = f
	end
	return f :: Folder
end

local function tag(p: BasePart, kind: string, look: string?)
	p:SetAttribute("Kind", kind)
	if look and look ~= "" then
		p:SetAttribute("Look", look)
	end
end

local count = 0
for _, s in BOXES do
	local kind = s[3] :: string
	local size = Vector3.new(s[8] :: number, s[9] :: number, s[10] :: number)
	local small = math.min(size.X, size.Z) < 4 or size.Y < 4
	local p = box(
		sec(s[1] :: string),
		s[2] :: string,
		size,
		at(s[5] :: number, s[6] :: number, s[7] :: number),
		KIND[kind],
		{
			material = Enum.Material.SmoothPlastic,
			castShadow = not small or kind == "ceiling",
		}
	)
	tag(p, kind, s[4] :: string)
	count += 1
end

for _, s in ORIENTED do
	local pos = Vector3.new(s[4] :: number, s[5] :: number, s[6] :: number)
	local right = Vector3.new(s[10] :: number, s[11] :: number, s[12] :: number)
	local up = Vector3.new(s[13] :: number, s[14] :: number, s[15] :: number)
	local cf = CFrame.fromMatrix(pos, right, up)
	local p = box(
		sec(s[1] :: string),
		s[2] :: string,
		Vector3.new(s[7] :: number, s[8] :: number, s[9] :: number),
		cf,
		KIND[s[3] :: string],
		{
			material = Enum.Material.SmoothPlastic,
			castShadow = false,
		}
	)
	tag(p, s[3] :: string, nil)
	count += 1
end

-- WedgePart: low at local -Z, high at +Z; yaw turns that toward the climb.
for _, s in RAMPS do
	local size = Vector3.new(s[6] :: number, s[7] :: number, s[8] :: number)
	local p = wedge(
		sec(s[1] :: string),
		s[2] :: string,
		size,
		at(s[3] :: number, s[4] :: number, s[5] :: number, s[9] :: number),
		KIND.ramp,
		{
			material = Enum.Material.SmoothPlastic,
		}
	)
	tag(p, "ramp", nil)
	count += 1
end

for _, s in CYLS do
	local p = cyl(
		sec(s[1] :: string),
		s[2] :: string,
		s[7] :: number,
		s[8] :: number,
		at(s[4] :: number, s[5] :: number, s[6] :: number),
		KIND[s[3] :: string],
		{
			material = Enum.Material.SmoothPlastic,
		}
	)
	tag(p, s[3] :: string, nil)
	count += 1
end

spawnsClear()
for _, s in SPAWNS do
	spawnPad(
		s[1] :: string,
		s[2] :: number,
		at(s[3] :: number, 0, s[4] :: number, if s[1] == "A" then 180 else 0)
	)
end
for i, b in BARRIERS do
	barrier(
		"Barrier" .. i,
		Vector3.new(b[2] - b[1], b[4] - b[3], b[6] - b[5]),
		at((b[1] + b[2]) / 2, (b[3] + b[4]) / 2, (b[5] + b[6]) / 2)
	)
end

report(
	string.format("Greenhouse greybox: %d parts, %d spawns, %d barriers", count, #SPAWNS, #BARRIERS)
)
