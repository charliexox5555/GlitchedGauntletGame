local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Greybox", name)
		sections[name] = f
	end
	return f :: Folder
end

local count = 0
for _, s in BOXES do
	local kind = s[3] :: string
	local x0, x1, y0, y1, z0, z1 =
		s[4] :: number,
		s[5] :: number,
		s[6] :: number,
		s[7] :: number,
		s[8] :: number,
		s[9] :: number
	local size = Vector3.new(x1 - x0, y1 - y0, z1 - z0)
	local small = math.min(size.X, size.Z) < 4 or size.Y < 4
	local p = box(
		sec(s[1] :: string),
		s[2] :: string,
		size,
		at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		KIND[kind],
		{
			material = MATERIAL[kind],
			castShadow = not small or kind == "ceiling", -- ceilings keep the inside dark
		}
	)
	p:SetAttribute("Kind", kind)
	-- Train side sheets: guns with ThinWall penetration shoot through them (Config/Combat).
	local name = s[2] :: string
	if
		kind == "train" and (string.sub(name, 1, 5) == "Lower" or string.sub(name, 1, 5) == "Upper")
	then
		CollectionServiceM:AddTag(p, "ThinWall")
	end
	count += 1
end

-- WedgePart: low at local -Z, high at +Z, so a ramp rising toward -Z turns 180 degrees.
for _, s in RAMPS do
	local x0, x1, y0, y1, z0, z1 =
		s[3] :: number,
		s[4] :: number,
		s[5] :: number,
		s[6] :: number,
		s[7] :: number,
		s[8] :: number
	local up = s[9] :: number
	local size = Vector3.new(x1 - x0, y1 - y0, z1 - z0)
	local p = wedge(
		sec(s[1] :: string),
		s[2] :: string,
		size,
		at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2, if up > 0 then 0 else 180),
		KIND.ramp,
		{
			material = MATERIAL.ramp,
		}
	)
	p:SetAttribute("Kind", "ramp")
	count += 1
end

spawnsClear()
for _, s in SPAWNS do
	spawnPad(
		s[1] :: string,
		s[2] :: number,
		at(s[3] :: number, 14, s[4] :: number, if s[1] == "A" then 180 else 0)
	)
end
for i, b in BARRIERS do
	barrier(
		"Barrier" .. i,
		Vector3.new(b[2] - b[1], b[4] - b[3], b[6] - b[5]),
		at((b[1] + b[2]) / 2, (b[3] + b[4]) / 2, (b[5] + b[6]) / 2)
	)
end

report(string.format("Metro greybox: %d parts, %d spawns, %d barriers", count, #SPAWNS, #BARRIERS))
