local mapCentre = W(CFrame.identity).Position
local posterN = 0
local function imageFor(part: BasePart): string?
	local n = part.Name
	local east = (part.CFrame.Position - mapCentre).X > 0
	if n == "WallBayPoster8_PosterL_Face" or n == "WallBayPoster8_PosterR_Face" then
		posterN += 1
		return "Poster" .. tostring((posterN - 1) % 4 + 1)
	elseif n == "WallBayMap8_Map_Face" then
		return "RouteMap"
	elseif n == "WallDoor8_Sign_Face" then
		return "Staff"
	elseif n == "NameSign_Name_Face" or n == "EndWall_Name_Face" then
		return "Name"
	elseif string.sub(n, 1, 14) == "PlatformSign_F" then
		return if east then "Platform1" else "Platform2"
	elseif string.sub(n, 1, 12) == "Gantry_Board" then
		return "Departures"
	elseif string.sub(n, 1, 12) == "Gantry_Sign1" then
		return "Platform1"
	elseif string.sub(n, 1, 12) == "Gantry_Sign2" then
		return "Platform2"
	elseif string.sub(n, 1, 12) == "Gantry_Clock" then
		return "Clock"
	elseif string.sub(n, 1, 10) == "Train_Dest" then
		return if east then "Dest1" else "Dest2"
	elseif n == "EndWall_Mouth_Face" or n == "Portal10_SignHall_Face" then
		return "Exit"
	elseif n == "Portal10_SignTicket_Face" then
		return "Platforms"
	elseif string.sub(n, 1, 10) == "Kiosk_Sign" then
		return "Coffee"
	elseif string.sub(n, 1, 13) == "Vending_Front" then
		return "Vending"
	elseif n == "TicketOffice_Sign_Face" then
		return "Tickets"
	end
	return nil
end

local function faceToward(part: BasePart, dir: Vector3): Enum.NormalId
	local best, bestDot = Enum.NormalId.Front, -math.huge
	for _, nid in Enum.NormalId:GetEnumItems() do
		local w = part.CFrame:VectorToWorldSpace(Vector3.FromNormalId(nid))
		local dot = w:Dot(dir)
		if dot > bestDot then
			best, bestDot = nid, dot
		end
	end
	return best
end

local function art(part: BasePart, face: Enum.NormalId, key: string, lit: boolean)
	local old = part:FindFirstChild("Art")
	if old then
		old:Destroy()
	end
	local g = Instance.new("SurfaceGui")
	g.Name = "Art"
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 50
	g.LightInfluence = if lit then 0 else 1
	g.Brightness = if lit then 1.15 else 1
	g.MaxDistance = 260
	g.Adornee = part
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.Image = "rbxassetid://" .. (IMAGES[key] or "")
	img.ScaleType = Enum.ScaleType.Stretch
	img.Parent = g
	g.Parent = part
end

local signs, missingArt = 0, {}
for _, sec in SECTIONS do
	for _, d in sec:GetDescendants() do
		if d:IsA("BasePart") and FACE[d.Name] then
			local key = imageFor(d)
			local m = d:FindFirstAncestorOfClass("Model")
			if key and m then
				if not IMAGES[key] then
					missingArt[key] = true
				end
				local dir = m:GetPivot():VectorToWorldSpace(FACE[d.Name])
				art(d, faceToward(d, dir), key, LIT[key] == true)
				signs += 1
			end
		end
	end
end

-- Flush paint (Parts are allowed as flush paint, Map Quality Standard section 3): MIND THE GAP on the platform floor
-- inboard of the tactile strip, and the end letter on each spawn room's back wall.
local function paint(name: string, size: Vector3, cf: CFrame, key: string, face: Enum.NormalId)
	local p = box(
		SECTIONS.Paint,
		name,
		size,
		cf,
		Color3.new(1, 1, 1),
		{ transparency = 1, castShadow = false }
	)
	decor(p)
	art(p, face, key, false)
	signs += 1
	return p
end
for _, z in { 36, 12, -12, -36 } do
