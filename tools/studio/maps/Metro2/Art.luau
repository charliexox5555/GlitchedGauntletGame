	paint(
		"MindGap",
		Vector3.new(0.05, 1.1, 8.6),
		at(17.4, 0.03, z, 0) * CFrame.Angles(0, 0, math.rad(90)),
		"MindGap",
		Enum.NormalId.Left
	)
	paint(
		"MindGap",
		Vector3.new(0.05, 1.1, 8.6),
		at(-17.4, 0.03, -z, 180) * CFrame.Angles(0, 0, math.rad(90)),
		"MindGap",
		Enum.NormalId.Left
	)
end
for _, d in greybox:GetDescendants() do
	if d:IsA("BasePart") and d.Name == "SpawnWall" and d.Size.X > 20 then
		local zrel = (d.CFrame.Position - mapCentre).Z
		local s = if zrel > 0 then 1 else -1
		local inner = d.CFrame.Position.Z - s * (d.Size.Z / 2 + 0.03)
		local local_ = W(CFrame.identity):PointToObjectSpace(
			Vector3.new(d.CFrame.Position.X, d.CFrame.Position.Y, inner)
		)
		paint(
			"SpawnLetter",
			Vector3.new(7, 7, 0.05),
			at(local_.X, local_.Y, local_.Z, if s > 0 then 180 else 0),
			if s > 0 then "SpawnB" else "SpawnA",
			Enum.NormalId.Front
		)
	end
end

local missing = {}
