local MaterialService = game:GetService("MaterialService")

newMap("Metro2", CFrame.new(3000, 200, 1500))

for name, v in VARIANTS do
	if v[3] == "" then
		continue
	end
	local found = MaterialService:FindFirstChild(name)
	local mv: MaterialVariant
	if found and found:IsA("MaterialVariant") then
		mv = found
	else
		mv = Instance.new("MaterialVariant")
		mv.Name = name
		mv.Parent = MaterialService
	end
	mv.BaseMaterial = (Enum.Material :: any)[v[1]]
	mv.StudsPerTile = v[2]
	mv.ColorMap = "rbxassetid://" .. v[3]
	mv.NormalMap = "rbxassetid://" .. v[4]
	mv.RoughnessMap = ""
	mv.MaterialPattern = Enum.MaterialPattern.Regular
end

local function look(part: BasePart, role: string, colour: Color3?)
	local l = ROLE[role]
	if not l then
		return
	end
	part.Color = colour or Color3.fromHex(l.color)
	part.Material = (Enum.Material :: any)[l.material]
	part.MaterialVariant = if VARIANTS[l.variant] and VARIANTS[l.variant][3] ~= ""
		then l.variant
		else ""
	if l.material == "Glass" then
		part.Transparency = if role == "Glass" then 0.55 else 0.15
	end
end

local SECTIONS = {
	Hall = section("Art", "Hall"),
	Walls = section("Art", "Walls"),
	Ceiling = section("Art", "Ceiling"),
	Track = section("Art", "Track"),
	Trains = section("Art", "Trains"),
	Concourse = section("Art", "Concourse"),
	Corridor = section("Art", "Corridor"),
	Story = section("Art", "Story"),
	Paint = section("Art", "Paint"),
}
for _, f in SECTIONS do
	f:ClearAllChildren()
end

local placed = 0
local function endColour(z: number): Color3
	if z > 0.5 then
		return Color3.fromHex(END_COLOUR.B)
	elseif z < -0.5 then
		return Color3.fromHex(END_COLOUR.A)
	end
	return Color3.fromHex(END_COLOUR.Mid)
end

-- End-colour parts (_Band, _Stripe, _Trim) take the colour of the half they stand in.
local function tint(m: Model, z: number)
	local c = endColour(z)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local n = d.Name
			if
				string.sub(n, -5) == "_Band"
				or string.sub(n, -7) == "_Stripe"
				or string.sub(n, -5) == "_Trim"
			then
				d.Color = c
			end
		end
	end
end

local function place(
	sec: string,
	piece: string,
	x: number,
	y: number,
	z: number,
	yaw: number
): Model?
	local m = put(SECTIONS[sec], piece, at(x, y, z, yaw))
	if m then
		tint(m, z)
		placed += 1
	end
	return m
end

local function both(sec: string, piece: string, x: number, y: number, z: number, yaw: number)
	place(sec, piece, x, y, z, yaw)
	place(sec, piece, -x, y, -z, yaw + 180)
end

