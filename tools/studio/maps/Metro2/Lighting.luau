--!strict
-- Metro2 lighting (vault/01 Design/Maps/Metro2.md -> Lighting): a bright station by day. The sun stands high and
-- falls through the skylight slot over the tracks; the vault's coffers glow; Ambient carries the hall's shade (the
-- old Metro was ClockTime 0, Brightness 0: the user's "too dark"). MapService applies the map's "Lighting"
-- Configuration and its "LightingFx" folder when the map loads and restores the place's own lighting afterwards.
-- Bundle with Art: bundle.py Metro2 Art Lighting. The LIGHT block is generated by tools/maps/metro2_style.py.
-- Practical light is Neon (coffers, coves, sconces, the board); PointLights only at the kiosks and the board,
-- shadowless (they don't show in edit-mode captures, LihFolk Stylized Lighting Recipes).

-- BEGIN LIGHT (generated by tools/maps/metro2_style.py --luau; edit the values there)
-- stylua: ignore start
local PROPS: { [string]: any } = {
	ClockTime = 13.2,
	GeographicLatitude = 30,
	Brightness = 1.2,
	Ambient = Color3.fromRGB(156, 152, 150),
	OutdoorAmbient = Color3.fromRGB(160, 160, 164),
	ColorShift_Top = Color3.fromRGB(255, 226, 190),
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
	EnvironmentDiffuseScale = 0.0,
	EnvironmentSpecularScale = 0.05,
	ExposureCompensation = 0.45,
	GlobalShadows = true,
	ShadowSoftness = 0.25,
}
local FX: { [string]: { [string]: any } } = {
	Atmosphere = { Density = 0.22, Offset = 0.05, Color = Color3.fromRGB(214, 216, 222), Decay = Color3.fromRGB(186, 190, 200), Glare = 0.0, Haze = 0.8 },
	Bloom = { Intensity = 0.85, Size = 28, Threshold = 0.92 },
	Grade = { Brightness = 0.02, Contrast = 0.16, Saturation = 0.0, TintColor = Color3.fromRGB(255, 246, 236) },
	SunRays = { Intensity = 0.05, Spread = 0.4 },
}
-- stylua: ignore end
-- END LIGHT

local map = newMap("Metro2", CFrame.new(3000, 200, 1500))

local old = map:FindFirstChild("Lighting")
if old then
	old:Destroy()
end
local config = Instance.new("Configuration")
config.Name = "Lighting"
for name, value in PROPS do
	config:SetAttribute(name, value)
end
config.Parent = map

local oldFx = map:FindFirstChild("LightingFx")
if oldFx then
	oldFx:Destroy()
end
local fx = Instance.new("Folder")
fx.Name = "LightingFx"

-- The day sky seen through the skylights: Dockyard2's harbour-day skybox (our own, make_dusk_sky.py).
local sky = Instance.new("Sky")
sky.Name = "DaySky"
sky.SkyboxBk = "rbxassetid://102637424570355"
sky.SkyboxFt = "rbxassetid://108516501181725"
sky.SkyboxLf = "rbxassetid://122502844689934"
sky.SkyboxRt = "rbxassetid://109028810530264"
sky.SkyboxUp = "rbxassetid://101311805128999"
sky.SkyboxDn = "rbxassetid://71458001248875"
sky.CelestialBodiesShown = true
sky.SunAngularSize = 12
sky.StarCount = 0
sky.Parent = fx

local function set(inst: Instance, props: { [string]: any })
	for k, v in props do
		(inst :: any)[k] = v
	end
end

local atmosphere = Instance.new("Atmosphere")
set(atmosphere, FX.Atmosphere)
atmosphere.Parent = fx
local bloom = Instance.new("BloomEffect")
set(bloom, FX.Bloom)
bloom.Parent = fx
local grade = Instance.new("ColorCorrectionEffect")
set(grade, FX.Grade)
grade.Parent = fx
local rays = Instance.new("SunRaysEffect")
set(rays, FX.SunRays)
rays.Parent = fx
fx.Parent = map

-- Warm, shadowless lights at the focal points: both kiosks and both faces of the departure board.
local lights = section("Art", "Lights")
lights:ClearAllChildren()
local count = 0
local function lamp(
	x: number,
	y: number,
	z: number,
	colour: Color3,
	brightness: number,
	range: number
)
	local p = box(
		lights,
		"Lamp",
		Vector3.new(0.4, 0.4, 0.4),
		at(x, y, z),
		colour,
		{ transparency = 1, castShadow = false }
	)
	decor(p)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = colour
	l.Shadows = false
	l.Parent = p
	count += 1
end
local WARM = Color3.fromRGB(255, 217, 168)
local AMBER = Color3.fromRGB(255, 181, 71)
for _, s in { 1, -1 } do
	lamp(24 * s, 7.5, 8 * s, WARM, 1.6, 16)
	lamp(0, 9.5, 4 * s, AMBER, 1.2, 18)
end

report(
	string.format(
		"Metro2 lighting: ClockTime %.1f, %d effects, %d lights (shadowless)",
		PROPS.ClockTime,
		#fx:GetChildren(),
		count
	)
)
