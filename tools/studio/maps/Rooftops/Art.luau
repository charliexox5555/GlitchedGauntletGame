local LOOK: { [string]: { color: Color3, material: Enum.Material } } = {
	Asphalt = { color = Color3.fromHex("2C2E33"), material = Enum.Material.Asphalt },
	Sidewalk = { color = Color3.fromHex("8C8A86"), material = Enum.Material.Concrete },
	RoadLine = { color = Color3.fromHex("D9D2B8"), material = Enum.Material.SmoothPlastic },
}

-- Kit placements.
local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Art", name)
		sections[name] = f
	end
	return f
end

local function endsWith(s: string, suffix: string): boolean
	return string.sub(s, -#suffix) == suffix
end

local placed = 0
for _, p in PLACE do
	local m = put(sec(p.sec), p.piece, at(p.x, p.y, p.z, p.yaw))
	if not m then
		continue
	end
	placed += 1
	local scale = p.scale
	if scale then
		m:ScaleTo(scale)
	end
	local tint = if p.tint then Color3.fromHex(p.tint) else nil
	local glow = if p.glow then Color3.fromHex(p.glow) else nil
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			if tint and endsWith(d.Name, "_Wall") then
				d.Color = tint
			elseif glow and (endsWith(d.Name, "Sign_Glow") or endsWith(d.Name, "Neon_Glow")) then
				d.Color = glow
			end
		end
	end
end

-- Art Parts: the street, sidewalks and road lines (no collision; the kill height is far above).
local street = sec("Street")
for _, r in PARTS do
	local look = LOOK[r[2]]
	local x0, x1, y0, y1, z0, z1 = r[3], r[4], r[5], r[6], r[7], r[8]
	local p = box(
		street,
		r[1],
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		look.color,
		{ material = look.material, castShadow = false }
	)
	decor(p)
end

-- Hide the greybox the kit replaced (it stays the collision). Facade bodies and rails go with the
-- pieces that dress them.
local STAND_IN: { [string]: string } = { Facade = "Facade8A", Rail = "Stair16" }
local hidden = 0
for _, d in greybox:GetDescendants() do
	if d:IsA("BasePart") then
		local art = d:GetAttribute("Art") :: string?
		if art and kit(STAND_IN[art] or art) then
			hide(d)
			hidden += 1
		end
	end
end

report(
	string.format(
		"Rooftops art: %d of %d kit pieces placed, %d art Parts, %d greybox parts hidden; %s",
		placed,
		#PLACE,
		#PARTS,
		hidden,
		missingReport()
	)
)
