local MaterialService = game:GetService("MaterialService")

local MAP_ORIGIN = CFrame.new(3000, 200, 0)
local map = newMap("Rooftops2", MAP_ORIGIN)
local greybox = layer("Greybox")

-- The Roof2_* MaterialVariants (our trim-sheet rows plus the Lobby's tile; BasePart.Color sets the hue).
-- An empty roughness id leaves the map unset (the base material's roughness).
for name, v in VARIANTS do
	local found = MaterialService:FindFirstChild(name)
	local mv: MaterialVariant
	if found and found:IsA("MaterialVariant") then
		mv = found
	else
		mv = Instance.new("MaterialVariant")
		mv.Name = name
		mv.Parent = MaterialService
	end
	mv.BaseMaterial = (Enum.Material :: any)[v[1]]
	mv.StudsPerTile = v[2]
	mv.ColorMap = "rbxassetid://" .. v[3]
	mv.NormalMap = "rbxassetid://" .. v[4]
	mv.RoughnessMap = if v[5] ~= "" then "rbxassetid://" .. v[5] else ""
	mv.MaterialPattern = Enum.MaterialPattern.Regular
end

local function apply(part: BasePart, role: string, color: Color3?)
	local look = ROLE[role]
	if not look then
		return
	end
	part.Color = color or Color3.fromHex(look.color)
	if look.material == "Neon" or part:GetAttribute("Glow") then
		part.Material = Enum.Material.Neon
		return
	end
	part.Material = (Enum.Material :: any)[look.material]
	part.MaterialVariant = look.variant
	if look.material == "Glass" then
		part.Transparency = 0.5
	end
end

local function toneColor(tone: string?): Color3?
	local hex = if tone then TONE[tone] else nil
	return if hex then Color3.fromHex(hex) else nil
end

-- Restyles a placed kit piece by role: Wall parts take the building's plaster tone; Glow parts take the
-- placement's glow role (the side colour of a roof sign).
local function restyle(m: Instance, tone: string?, glow: string?)
	local wall = toneColor(tone)
	for _, d in m:GetDescendants() do
		if not d:IsA("BasePart") then
			continue
		end
		local role = PART_ROLE[d.Name]
		if not role then
			continue
		end
		if wall and role == "Wall" then
			apply(d, role, wall)
		elseif role == "Shutter" and tone == "teamA" then
			apply(d, "Accent") -- concept pass: cobalt shutters on the A roof, green elsewhere
		elseif glow and (role == "GlowWest" or role == "GlowEast") then
			apply(d, glow)
		else
			apply(d, role)
		end
	end
end

local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Art", name)
		sections[name] = f
	end
	return f
end
-- Fresh sections even when a list is empty (a re-run never leaves stale art behind).
for _, name in { "Facades", "Structure", "Props", "Signs", "Street", "Skyline" } do
	sec(name)
end

-- Kit pieces.
local placed = 0
for i, p in PLACE do
	local m = put(sec(p.sec), p.piece, at(p.x, p.y, p.z, p.yaw))
	if m then
		if p.scale then
			m:ScaleTo(p.scale)
		end
		restyle(m, p.tone, p.glow)
		placed += 1
	end
	if i % 150 == 0 then
		task.wait()
	end
end

-- Maps v5: Codex's original billboard artwork (fictional brands, no lettering;
-- art-source/maps/Rooftops2/textures/billboards, cropped to each panel) as
-- decals on the panel faces, so no sign stands blank. Image ids are the Decal
-- uploads resolved in Studio.
local ADVERT = {
	cinema = "rbxassetid://106896850537878",
	scooter = "rbxassetid://96395685091459",
	soda = "rbxassetid://126862573725688",
	cafe = "rbxassetid://104568756088714",
}
local function advert(panel: BasePart?, dirWorld: Vector3, image: string)
	if not panel then
		return
	end
	local best, bestDot = Enum.NormalId.Front, -2
	for _, face in Enum.NormalId:GetEnumItems() do
		local n = panel.CFrame:VectorToWorldSpace(Vector3.FromNormalId(face))
		if n:Dot(dirWorld) > bestDot then
			best, bestDot = face, n:Dot(dirWorld)
		end
	end
	local d = Instance.new("Decal")
	d.Name = "Advert"
	d.Face = best
	d.Texture = image
	d.Color3 = Color3.fromRGB(232, 220, 208) -- maps v5 round 2: a touch muted, so the art sits in the palette
	d.Parent = panel
end
for _, m in sec("Props"):GetChildren() do
	if m:IsA("Model") and m.Name == "RoofSign" then
		local pv = m:GetPivot()
		local west = pv.X < MAP_ORIGIN.X
		-- lihfolk-ignore: findfirstchild-chain (nil-checked in advert)
		local panel = m:FindFirstChild("RoofSign_Poster") :: BasePart?
		advert(panel, pv.XVector, if west then ADVERT.cinema else ADVERT.scooter)
		advert(panel, -pv.XVector, if west then ADVERT.scooter else ADVERT.cinema)
	elseif m:IsA("Model") and m.Name == "Billboard22" then
		local pv = m:GetPivot()
		local north = pv.Z > MAP_ORIGIN.Z
		-- lihfolk-ignore: findfirstchild-chain (nil-checked in advert)
		local cloth = m:FindFirstChild("Billboard22_Cloth") :: BasePart?
		-- both faces carry art (the back read as a blank board across the Pit)
		advert(cloth, pv.ZVector, if north then ADVERT.soda else ADVERT.cafe)
		advert(cloth, -pv.ZVector, if north then ADVERT.cafe else ADVERT.soda)
	end
end

-- Art Parts: the street, sidewalks and road lines far below (no collision).
for _, r in PARTS do
	local x0, x1, y0, y1, z0, z1 = r[3], r[4], r[5], r[6], r[7], r[8]
	local part = box(
		sec("Street"),
		r[1],
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		Color3.new(1, 1, 1),
		{ castShadow = false }
	)
	apply(part, r[2])
	decor(part)
end

-- Hide the greybox the kit replaced (it stays the collision); restyle what stays visible.
local STAND_IN: { [string]: string } =
	{ Facade = "Facade8A", Rail = "Stair16", Penthouse = "PenthouseA" }
local LOOK_ROLE: { [string]: string } = {
	Roof = "Roof",
	RoofPit = "RoofPit",
	Brick = "Stone", -- concept pass 2026-11-05: cream stone parapets and piers with cobalt caps
	Coping = "Trim",
	PierCap = "Accent",
	Ledge = "Ledge",
}
local hidden = 0
for _, d in greybox:GetDescendants() do
	if d:IsA("BasePart") then
		local art = d:GetAttribute("Art") :: string?
		local look = d:GetAttribute("Look") :: string?
		if art and kit(STAND_IN[art] or art) then
			hide(d)
			hidden += 1
		elseif look == "PierCap" and kit("PierCap") then
			-- fix round 1: a modelled cobalt cap on every pier (the greybox cap stays the collision)
			hide(d)
			hidden += 1
			put(
				sec("Structure"),
				"PierCap",
				MAP_ORIGIN:ToObjectSpace(d.CFrame) * CFrame.new(0, -d.Size.Y / 2, 0)
			)
		elseif look and LOOK_ROLE[look] then
			local role = LOOK_ROLE[look]
			local tone = d:GetAttribute("Tone") :: string?
			apply(d, role, if role == "Wall" then toneColor(tone) else nil)
		end
	end
end

local meshes = 0
for _, d in layer("Art"):GetDescendants() do
	if d:IsA("MeshPart") then
		meshes += 1
	end
end
map:SetAttribute("ArtMeshParts", meshes)
report(
	string.format(
		"Rooftops2 art: %d of %d kit placements, %d art parts, %d greybox parts hidden, %d MeshParts; %s",
		placed,
		#PLACE,
		#PARTS,
		hidden,
		meshes,
		missingReport()
	)
)
