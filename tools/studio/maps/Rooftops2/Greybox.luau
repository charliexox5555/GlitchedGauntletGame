local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Greybox", name)
		sections[name] = f
	end
	return f
end

local function lookOf(s: Solid): (Color3, Enum.Material)
	local l = s.look and LOOK[s.look]
	if l then
		local color = l.color
		if s.look == "Brick" and s.tone and TONE[s.tone] then
			color = TONE[s.tone]
		end
		return color, l.material
	end
	local material = if s.kind == "body"
			or s.kind == "flue"
			or s.kind == "hut"
		then Enum.Material.Concrete
		else Enum.Material.SmoothPlastic
	local color = KIND_COLOR[s.kind] or Color3.fromRGB(150, 150, 154)
	if (s.kind == "body" or s.kind == "flue") and s.tone and TONE[s.tone] then
		color = TONE[s.tone]
	end
	return color, material
end

local function tag(part: BasePart, s: Solid)
	part:SetAttribute("Kind", s.kind)
	if s.art then
		part:SetAttribute("Art", s.art)
	end
	if s.tone then
		part:SetAttribute("Tone", s.tone)
	end
	if s.look then
		part:SetAttribute("Look", s.look)
	end
end

local count = 0
for _, s in LAYOUT do
	local b = s.b
	local sx, sy, sz = b[2] - b[1], b[4] - b[3], b[6] - b[5]
	local cx, cy, cz = (b[1] + b[2]) / 2, (b[3] + b[4]) / 2, (b[5] + b[6]) / 2
	local color, material = lookOf(s)
	local look: Look = {
		material = material,
		-- Shadows only from things big enough to matter (mobile budget); edges and rails never.
		castShadow = sy >= 6 and s.kind ~= "rail",
	}
	local folder = sec(SECTION_OF[s.kind] or "Other")
	local part: BasePart
	if s.up then
		local up = s.up :: { number }
		local yaw = math.deg(math.atan2(up[1], up[2]))
		local along = math.abs(up[1]) * sx + math.abs(up[2]) * sz
		local across = math.abs(up[2]) * sx + math.abs(up[1]) * sz
		part =
			wedge(folder, s.name, Vector3.new(across, sy, along), at(cx, cy, cz, yaw), color, look)
	elseif s.slope then
		-- A rail along a stair: a thin bar from its low end to its high end (0.3 x 0.3 section).
		local sl = s.slope :: { number }
		local a = Vector3.new(cx, sl[1] + 0.15, b[5])
		local c = Vector3.new(cx, sl[2] + 0.15, b[6])
		local mid = (a + c) / 2
		part = box(
			folder,
			s.name,
			Vector3.new(sx, 0.3, (c - a).Magnitude),
			CFrame.lookAt(mid, c),
			color,
			look
		)
	else
		part = box(folder, s.name, Vector3.new(sx, sy, sz), at(cx, cy, cz), color, look)
	end
	tag(part, s)
	count += 1
end

-- Spawns (4 per team, facing the middle) and the full-width barriers behind each Penthouse.
spawnsClear()
for i, s in SPAWNS_A do
	spawnPad("A", i, at(s[1], 0, s[2], 180))
end
for i, s in SPAWNS_B do
	spawnPad("B", i, at(s[1], 0, s[2], 0))
end
barrier("Barrier_A", Vector3.new(BARRIER_W, 30, 1), at(0, 15, -BARRIER_Z))
barrier("Barrier_B", Vector3.new(BARRIER_W, 30, 1), at(0, 15, BARRIER_Z))

