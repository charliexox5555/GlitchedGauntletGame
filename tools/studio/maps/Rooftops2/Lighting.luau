--!strict
-- Rooftops2 lighting (vault/01 Design/Maps/Rooftops2.md -> Look): a golden afternoon over the roofs.
-- MapService applies the map's "Lighting" Configuration (attributes = Lighting properties) and its
-- "LightingFx" folder (Sky, Atmosphere, effects) when the map loads, and restores the place's own
-- lighting afterwards. Bundle with Art: bundle.py Rooftops2 Art Lighting.
--
-- The LIGHT block is generated from tools/maps/rooftops2_style.py (LIGHTING, FX, LAMP); change the values
-- there and run python tools/maps/rooftops2_style.py --luau. LihFolk Stylized Lighting Recipes §3.1
-- ("Bright cartoon") is the base, warmer and lower: the sun rakes across the map along X (latitude chosen
-- in Studio so GetSunDirection().Z ~ 0), so neither team looks into it. Local lights: the two billboard
-- floods and the two roof-sign spills (shadowless). To see it: playtest with ForceMap = "Rooftops2".

-- BEGIN LIGHT (generated by tools/maps/rooftops2_style.py --luau; edit the values there)
-- stylua: ignore start
local PROPS: { [string]: any } = {
	ClockTime = 17.1,
	GeographicLatitude = 23.5,
	Brightness = 3.2,
	Ambient = Color3.fromRGB(124, 118, 136),
	OutdoorAmbient = Color3.fromRGB(150, 142, 172),
	ColorShift_Top = Color3.fromRGB(255, 178, 110),
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
	EnvironmentDiffuseScale = 0.35,
	EnvironmentSpecularScale = 0.15,
	ExposureCompensation = -0.15,
	GlobalShadows = true,
	ShadowSoftness = 0.2,
}
local FX: { [string]: { [string]: any } } = {
	Atmosphere = { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(246, 204, 166), Decay = Color3.fromRGB(214, 160, 150), Glare = 0.7, Haze = 1.4 },
	Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.25 },
	Grade = { Brightness = 0.02, Contrast = 0.12, Saturation = 0.08, TintColor = Color3.fromRGB(255, 236, 214) },
	SunRays = { Intensity = 0.18, Spread = 0.7 },
}
local LAMP = { color = Color3.fromRGB(255, 214, 170), brightness = 1.6, range = 30 }
-- stylua: ignore end
-- END LIGHT

local map = newMap("Rooftops2", CFrame.new(3000, 200, 0))

local old = map:FindFirstChild("Lighting")
if old then
	old:Destroy()
end
local config = Instance.new("Configuration")
config.Name = "Lighting"
for name, value in PROPS do
	config:SetAttribute(name, value)
end
config.Parent = map

local oldFx = map:FindFirstChild("LightingFx")
if oldFx then
	oldFx:Destroy()
end
local fx = Instance.new("Folder")
fx.Name = "LightingFx"

local sky = Instance.new("Sky")
sky.Name = "AfternoonSky"
sky.CelestialBodiesShown = true
sky.SunAngularSize = 14
sky.MoonAngularSize = 0 -- round 4: the moon read as a green blob on the horizon
sky.StarCount = 0
sky.Parent = fx

local function set(inst: Instance, props: { [string]: any })
	for k, v in props do
		(inst :: any)[k] = v
	end
end

local atmosphere = Instance.new("Atmosphere")
set(atmosphere, FX.Atmosphere)
atmosphere.Parent = fx
local bloom = Instance.new("BloomEffect")
set(bloom, FX.Bloom)
bloom.Parent = fx
local grade = Instance.new("ColorCorrectionEffect")
set(grade, FX.Grade)
grade.Parent = fx
local rays = Instance.new("SunRaysEffect")
set(rays, FX.SunRays)
rays.Parent = fx
fx.Parent = map

-- Floods on the billboards and spills under the roof signs: warm, shadowless.
local lights = section("Art", "Lights")
local count = 0
for _, s in { 1, -1 } do
	for _, q in { { -10, 6, 19 }, { -38, 20, 0 } } do
		local p = box(
			lights,
			"Light",
			Vector3.new(0.4, 0.4, 0.4),
			at(q[1] * s, q[2], q[3] * s),
			LAMP.color,
			{ transparency = 1, castShadow = false }
		)
		decor(p)
		local light = Instance.new("PointLight")
		light.Range = LAMP.range
		light.Brightness = LAMP.brightness
		light.Color = LAMP.color
		light.Shadows = false
		light.Parent = p
		count += 1
	end
end

report(
	string.format(
		"Rooftops2 lighting: ClockTime %.2f, %d effects, %d lights (shadowless)",
		PROPS.ClockTime,
		#fx:GetChildren(),
		count
	)
)
