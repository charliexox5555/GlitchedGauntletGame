local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Greybox", name)
		sections[name] = f
	end
	return f
end

local function tag(part: BasePart, p: Piece, half: string)
	part:SetAttribute("Kind", p.kind)
	part:SetAttribute("Half", half)
	if p.piece then
		part:SetAttribute("Piece", p.piece)
	end
end

local count = 0
for _, p in LAYOUT do
	local half = if p.z > 0.01 then "B" elseif p.z < -0.01 then "A" else "C"
	local folder = sec(SECTION_OF[p.kind] or "Cover")
	local color = KIND_COLOR[p.kind] or KIND_COLOR.full
	local look: Look = {
		material = KIND_MATERIAL[p.kind] or Enum.Material.SmoothPlastic,
		castShadow = p.h >= 6 and p.y0 >= -0.5,
	}
	if p.piece == "Station" and p.kind == "full" then
		look.material = Enum.Material.Metal
	end
	if p.kind == "ramp" then
		local up = p.up :: { number }
		local yaw = math.deg(math.atan2(up[1], up[2]))
		-- Width across the climb, length along it (the wedge rises toward its local +Z).
		local along = math.abs(up[1]) * p.sx + math.abs(up[2]) * p.sz
		local across = math.abs(up[2]) * p.sx + math.abs(up[1]) * p.sz
		local w = wedge(
			folder,
			p.name,
			Vector3.new(across, p.h, along),
			at(p.x, p.y0 + p.h / 2, p.z, yaw),
			color,
			look
		)
		tag(w, p, half)
		count += 1
	elseif p.kind == "roof" then
		-- Gable, ridge along Z: two wedges rising toward the middle from the long sides.
		for _, side in { -1, 1 } do
			local w = wedge(
				folder,
				p.name,
				Vector3.new(p.sz, p.h, p.sx / 2),
				at(p.x + side * p.sx / 4, p.y0 + p.h / 2, p.z, if side < 0 then 90 else -90),
				color,
				look
			)
			tag(w, p, half)
			count += 1
		end
	else
		local b = box(
			folder,
			p.name,
			Vector3.new(p.sx, p.h, p.sz),
			at(p.x, p.y0 + p.h / 2, p.z),
			color,
			look
		)
		tag(b, p, half)
		count += 1
	end
end

-- Spawns (4 per team, facing the centre) and the barriers across the alcove mouths.
spawnsClear()
for i, s in SPAWNS_A do
	spawnPad("A", i, at(s[1], 0, s[2], 180))
end
for i, s in SPAWNS_B do
	spawnPad("B", i, at(s[1], 0, s[2], 0))
end
barrier("Barrier_A", Vector3.new(32, 30, 1), at(0, 15, -80.5))
barrier("Barrier_B", Vector3.new(32, 30, 1), at(0, 15, 80.5))

map:SetAttribute("Layout", "tools/maps/snowpeak_layout.py")
-- The drop-off beyond the fences: anyone who goes over dies 40 below the map (MapService default).
map:SetAttribute("KillDepth", 40)
report(
	string.format(
		"Snowpeak greybox: %d parts, %d + %d spawns, 2 barriers",
		count,
		#SPAWNS_A,
		#SPAWNS_B
	)
)
