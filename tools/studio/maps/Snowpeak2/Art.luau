local sections: { [string]: Folder } = {}
local function sec(name: string): Folder
	local f = sections[name]
	if not f then
		f = section("Art", name)
		sections[name] = f
	end
	return f
end

-- End colour on a kit model: parts named *_Paint (B blue, A gold).
local function paint(m: Model?, hex: string?)
	if not (m and hex) then
		return
	end
	local color = Color3.fromHex(hex)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and string.sub(d.Name, -6) == "_Paint" then
			d.Color = color
		end
	end
end

local found: { [string]: boolean } = {}
local placed = 0
for _, p in PLACEMENTS do
	local m = put(sec(p.section), p.piece, at(p.x, p.y, p.z, p.yaw))
	if m then
		found[p.piece] = true
		placed += 1
		paint(m, p.paint)
	end
end

-- Greybox: hide what the kit dresses; the floors stay visible (snow, terrace, Lodge floor, ice).
local KEEP: { [string]: boolean } = { ground = true, terrace = true, floor = true, ice = true }
local hidden = 0
for _, d in greybox:GetDescendants() do
	if d:IsA("BasePart") then
		local kind = d:GetAttribute("Kind") :: string?
		local pieceName = d:GetAttribute("Piece") :: string?
		if kind and KEEP[kind] then
			local g = GREYBOX[kind]
			if g then
				d.Color = Color3.fromHex(g[1])
				d.Material = (Enum.Material :: any)[g[2]]
				d.MaterialVariant = g[3]
			end
			if kind == "ice" then
				d.Reflectance = 0.12
			end
		elseif pieceName and found[pieceName] then
			hide(d)
			hidden += 1
		end
	end
end

-- Signs: a rendered-font decal on an invisible board just in front of each kit sign board (no part-built or GUI text).
local function sign(name: string, text: string, size: Vector3, cf: CFrame, _color: Color3)
	local board = box(
		sec("Signs"),
		name,
		size,
		cf,
		Color3.new(0, 0, 0),
		{ transparency = 1, castShadow = false }
	)
	decor(board)
	board:SetAttribute("AllowFloat", true) -- an invisible decal carrier in front of its kit sign board
	local image = SIGN[text]
	if image and image ~= "" then
		local d = Instance.new("Decal")
		d.Name = "SignArt"
		d.Face = Enum.NormalId.Front
		d.Texture = "rbxassetid://" .. image
		d.Parent = board
	end
end

